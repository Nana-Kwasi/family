# Copy to .env and adjust. Every value has a working default for local development.

# --- Database ---------------------------------------------------------------
DB_NAME=mama_africa_ai
DB_USERNAME=mama
DB_PASSWORD=mama
# Host port for the Postgres container. Change it if 5432 is already taken on your machine.
DB_PORT=5432

# --- AI provider ------------------------------------------------------------
# Development (local Ollama, Gemma 3 1B):
AI_PROVIDER=OLLAMA
AI_BASE_URL=http://localhost:11434
AI_MODEL=gemma3:1b
AI_API_KEY=

# Hosted Gemma 3 12B — swap these, change nothing else.
#
# DeepInfra (pay per token, no minimum — cheapest way to evaluate 12B):
# AI_PROVIDER=OPENAI
# AI_BASE_URL=https://api.deepinfra.com/v1/openai
# AI_MODEL=google/gemma-3-12b-it
# AI_API_KEY=<deepinfra-token>
#
# RunPod serverless (dedicated GPU; worth it only at sustained high volume,
# and it requires a $150 minimum credit top-up):
# AI_PROVIDER=OPENAI
# AI_BASE_URL=https://api.runpod.ai/v2/<endpoint-id>/openai/v1
# AI_MODEL=google/gemma-3-12b-it
# AI_API_KEY=<runpod-api-key>

AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1024
AI_TIMEOUT=120s

# --- Security ---------------------------------------------------------------
JWT_SECRET=change-me-in-production-this-must-be-at-least-32-characters-long
JWT_EXPIRATION=12h
ADMIN_EMAIL=admin@mamaafrica.ai
ADMIN_PASSWORD=ChangeMe123!

# Leave blank locally. In production set a value and have the website send it as X-Api-Key.
PUBLIC_API_KEY=

# Any local port, so it does not matter which one Vite or `serve` happens to pick.
# setAllowedOriginPatterns understands wildcards, unlike a plain origin list.
# Production MUST replace this with real origins — ProductionSafetyCheck refuses to start
# with `localhost` here under the prod profile, so this cannot ship by accident.
CORS_ALLOWED_ORIGINS=http://localhost:[*],http://127.0.0.1:[*]

# --- Knowledge base / RAG ---------------------------------------------------
# IN_PROCESS needs no extra service. Switch to OLLAMA or OPENAI for stronger embeddings,
# then re-index — a Qdrant collection's vector size is fixed when it is created.
EMBEDDING_PROVIDER=IN_PROCESS
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text

QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_COLLECTION=mama_africa_knowledge

RAG_ENABLED=true
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_MAX_RESULTS=5
RAG_MIN_SCORE=0.6

MAX_UPLOAD_SIZE=25MB

# --- Mama Africa Market -----------------------------------------------------
# Absolute path to the website's public/images folder. Read-only; powers the product
# editor's image picker. Leave blank to disable the picker.
MARKET_IMAGE_ROOT=

# --- Email (optional) -------------------------------------------------------
# Leave MAIL_HOST blank and the application still runs: support notifications and
# password-reset emails are skipped and logged instead of failing the request.
# For Gmail use smtp.gmail.com:587 with an App Password, not the account password.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# Where support enquiries are announced.
SUPPORT_INBOX=Mamaafricaafia@gmail.com
# Origin used to build password-reset links.
PUBLIC_SITE_URL=http://localhost:3002
