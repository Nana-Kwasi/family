# Leave unset in development — Vite proxies /api to http://localhost:8080.
# Set to the deployed backend origin for production builds, e.g. https://ai.mamaafrica.com
VITE_API_BASE_URL=

# Origin of the Mama Africa website. Product images are stored as site-relative paths
# (/images/...), so the console needs to know where to load them from for previews.
# Development default is http://localhost:3002.
VITE_SITE_BASE_URL=
