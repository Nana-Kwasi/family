# Optional: GA4 Measurement ID — analytics tags load only after banner consent
REACT_APP_GA_MEASUREMENT_ID=

# Official checkout preference when a product has both Printify + Etsy URLs: printify | etsy
REACT_APP_OFFICIAL_STORE_PRIORITY=printify

REACT_APP_PRINTIFY_STORE_URL=
REACT_APP_ETSY_STORE_URL=

# Used for certificate share links when developing on localhost
REACT_APP_PUBLIC_SITE_URL=

# Mama Africa backend. Serves both the culture-page assistant (/api/chat) and the shop
# (/api/storefront) — the store catalogue lives in the database, not in the site's source.
REACT_APP_AI_API_URL=http://localhost:8080
# Set only if the backend has PUBLIC_API_KEY configured
REACT_APP_AI_API_KEY=

# --- Firebase ---------------------------------------------------------------
# Only used for the order records in CartContext; accounts, stories, the shop and the
# culture pages all live in the Mama Africa backend now. These were previously hard-coded
# in src/firebase.js.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# --- EmailJS ----------------------------------------------------------------
# Book-review notifications only. The support form posts to the backend instead, so its
# rate limit cannot be bypassed from the browser.
REACT_APP_EMAILJS_SERVICE_ID=
REACT_APP_EMAILJS_FEEDBACK_TEMPLATE=
REACT_APP_EMAILJS_PUBLIC_KEY=
